      "item": [
        {
          "id": "48df9429-e3c0-446a-b8ff-2871f0345324",
          "name": "Generate token with user authorities (Login)",
          "request": {
            "name": "Generate token with user authorities (Login)",
            "description": {
              "content": "Logs in a user with the provided username and password using Basic Authentication.\nReturns a JWT token containing the authenticated user's authorities and tenant location information.\nThis endpoint provides comprehensive token generation with full permission context.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "provider",
                "token-with-authorities"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "734617be-b8c3-4b8f-9e06-676d20f0cba2",
              "name": "Successfully authenticated and generated token.",
              "originalRequest": {
                "url": {
                  "path": [
                    "provider",
                    "token-with-authorities"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"location\": \"string\",\n  \"token\": \"string\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
