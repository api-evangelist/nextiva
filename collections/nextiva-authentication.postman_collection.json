        {
          "id": "ea450ab1-1ef3-4441-8cbb-e462922daf26",
          "name": "Refresh authentication token",
          "request": {
            "name": "Refresh authentication token",
            "description": {
              "content": "Refreshes an existing authentication token. This endpoint uses the current valid token\n(typically sent as a Bearer token in the Authorization header) to obtain a new, updated token\nand location details.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "provider",
                "api",
                "token-refresh"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "9237bd59-0096-4b98-9125-971971b427c1",
              "name": "Token successfully refreshed.",
              "originalRequest": {
                "url": {
                  "path": [
                    "provider",
                    "api",
                    "token-refresh"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"clientLocation\": \"string\",\n  \"location\": \"string\",\n  \"token\": \"string\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
