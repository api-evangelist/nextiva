      "name": "SMS Messaging",
      "description": {
        "content": "Operations for sending and managing SMS messages.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d7f474cd-9a52-4b2c-aa74-fc97971f592c",
          "name": "Send an outbound SMS message",
          "request": {
            "name": "Send an outbound SMS message",
            "description": {
              "content": "Sends an outbound SMS message to a specified recipient. This API allows for associating the message with a campaign, contact, or workitem.\n\n**Note on Inbound SMS:** This SDK primarily exposes APIs for *sending* SMS. Direct webhook configuration for *receiving* inbound SMS is typically handled internally by the Nextiva platform. Inbound SMS events are then consumed by the SDK as Workitems (e.g., `WorkitemTypes.InboundSMS`) via the SDK's event stream, not through a public API for webhook configuration.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                "api",
                "sms"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"<string>\",\n  \"message\": \"<string>\",\n  \"campaignId\": \"<string>\",\n  \"contactId\": \"<string>\",\n  \"contactIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"file\": \"<binary>\",\n  \"files\": [\n    \"<binary>\",\n    \"<binary>\"\n  ],\n  \"force\": \"<boolean>\",\n  \"from\": \"<string>\",\n  \"groupSMSParentTicketId\": \"<string>\",\n  \"name\": \"<string>\",\n  \"nonAssignedAgentReply\": \"<boolean>\",\n  \"option\": \"<string>\",\n  \"ticketId\": \"<string>\",\n  \"toNumbers\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"workitemId\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
